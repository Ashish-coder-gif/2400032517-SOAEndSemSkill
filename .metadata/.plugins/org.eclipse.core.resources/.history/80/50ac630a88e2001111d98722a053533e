spring.application.name=GatewayService
server.port=8000

eureka.client.service-url.defaultZone=http://localhost:9000/eureka/

eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true

spring.cloud.gateway.discovery.locator.enabled=true
spring.cloud.gateway.discovery.locator.lower-case-service-id=true

spring.cloud.gateway.routes[0].id=tourism-service
spring.cloud.gateway.routes[0].uri=lb://TOURISM-SERVICE
spring.cloud.gateway.routes[0].predicates[0]=Path=/tourism/**

spring.cloud.gateway.routes[1].id=auth-service
spring.cloud.gateway.routes[1].uri=lb://TOURISM-SERVICE
spring.cloud.gateway.routes[1].predicates[0]=Path=/auth/**